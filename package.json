{
  "name": "rally-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 0.0.0.0",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:integration": "node --import tsx tests/integration.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run test && npm run build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "preview": "wrangler dev --ip 0.0.0.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.0",
    "qrcode": "^1.5.4",
    "three": "^0.180.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.43.0",
    "ws": "^8.18.0"
  }
}
