# Для Wrangler скопируйте этот файл в .dev.vars (не коммитить).
# Открытые параметры также заданы в wrangler.jsonc.
STUN_URLS="stun:stun.cloudflare.com:3478"
TURN_URLS=""
VOICE_RELAY_ONLY="false"
# Предпочтительно TURN REST / coturn use-auth-secret: сервер выдаёт ключ на 1 час.
TURN_SECRET=""
# Альтернатива только для временного тестового аккаунта TURN:
TURN_USERNAME=""
TURN_CREDENTIAL=""
# CLOUDFLARE_API_TOKEN и CLOUDFLARE_ACCOUNT_ID вводятся в GitHub Secrets,
# а не в Vite, исходники или этот файл.
